# Discord Bot (for live member count API)
# Get your Bot Token from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# Your Discord Server (Guild) ID
# Right-click your server > Copy Server ID (enable Developer Mode first)
DISCORD_GUILD_ID=your_guild_id_here

# Discord Webhook for the /services inquiry form
# Channel > Edit Channel > Integrations > Webhooks > New Webhook
DISCORD_INQUIRY_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://yourcommunity.gg
